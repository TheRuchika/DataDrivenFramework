<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name = "Login Suite using TestNG parameters">

    <listeners>
        <listener class-name="com.aventstack.extentreports.testng.listener.ExtentITestListenerAdapter"/>
    </listeners>

    <test name = "BothCorrect">
        <parameter name="username" value="Admin"/>
        <parameter name="password" value="admin123"/>
        <parameter name="validation" value="valid"/>
        <classes>
            <class name="DataDrivenTest.LoginUsingParameter"/>

        </classes>
    </test>

    <test name = "BothIncorrect">
        <parameter name="username" value="Dummy"/>
        <parameter name="password" value="Dummy123"/>
        <parameter name="validation" value="invalid"/>

        <classes>
            <class name="DataDrivenTest.LoginUsingParameter"/>

        </classes>
    </test>

    <test name = "CorrectPassword">
        <parameter name="username" value="Dummy"/>
        <parameter name="password" value="admin123"/>
        <parameter name="validation" value="invalid"/>

        <classes>
            <class name="DataDrivenTest.LoginUsingParameter"/>

        </classes>
    </test>

    <test name = "CorrectUsername">
        <parameter name="username" value="Admin"/>
        <parameter name="password" value="admin12344"/>
        <parameter name="validation" value="invalid"/>

        <classes>
            <class name="DataDrivenTest.LoginUsingParameter"/>

        </classes>
    </test>

</suite>